{
  "name": "spotmusic-android",
  "version": "1.0.18",
  "type": "module",
  "private": true,
  "description": "SpotMusic Mobile - Reproductor de Música Avanzado y Descargador para Android",
  "scripts": {
    "postinstall": "node scripts/patch-capacitor-cli-tar.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:build": "npm run build && cap sync android",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.0",
    "@capacitor/device": "^6.0.2",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/status-bar": "^6.0.2",
    "crypto-js": "^4.2.0",
    "lucide": "^0.475.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/crypto-js": "^4.2.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
